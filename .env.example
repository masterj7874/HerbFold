# Local workstation; bind to loopback unless you configure authentication below.
HERBFOLD_HOST=127.0.0.1
HERBFOLD_PORT=9018
HERBFOLD_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
HERBFOLD_DATA_DIR=runtime
HERBFOLD_API_TOKEN=
AF3_REPO_DIR=external/alphafold3
AF3_MODEL_DIR=
# Full official installation only: 8 FASTAs, mmcif_files, its inventory and
# official_databases_manifest.json with status=complete after full verification.
# A nonempty directory or upstream miniature test fixtures do not pass readiness.
# Keep the verified installation immutable; rerun installation validation after changes.
AF3_DB_DIR=
# Search mode runs one CPU MSA/template stage per verified protein/DB/version/cutoff
# cache identity, then separate ligand inference. None remains an explicit option.
AF3_MAX_TEMPLATE_DATE=2021-09-30
AF3_NUM_DIFFUSION_SAMPLES=5
AF3_NUM_RECYCLES=10
# Total CPU-search + inference deadline; 1..604800 seconds. Interrupted jobs require
# an explicit new retry; completed verified protein features remain reusable.
AF3_TIMEOUT_SECONDS=86400
# Stop sustained GPU allocation retries with no other log progress (0 disables).
AF3_GPU_ALLOCATION_RETRY_TIMEOUT_SECONDS=180
AF3_DEVICE=gpu
AF3_CUDA_VISIBLE_DEVICES=0
AF3_PREALLOCATE=false
# Child-process-only numerical workaround for JAX 0.10.2 on this Blackwell workstation.
# Revalidate with scripts/verify_af3_numerics.py after changing the JAX/GPU stack.
AF3_XLA_FLAGS=--xla_gpu_autotune_level=3
AF3_HMMER_DIR=external/tools/hmmer-3.4-af3/bin
# AF3 uses its own Python environment; configure the interpreter after installation.
AF3_PYTHON=
# IBM credentials can instead come from Qiskit's existing saved account.
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=

# Astra multi-agent coordinator (fixed model gpt-6-astra, no fallback)
# Read server-side; never include real keys in committed files.
OPENAI_API_KEY=
